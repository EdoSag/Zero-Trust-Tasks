<?xml version="1.0" encoding="utf-8"?>
<!--
  Task titles only appear here when "Show tasks on the home-screen widget"
  is on in Settings. Otherwise TaskListWidgetProvider fills only the header
  and the counts line; see HomeWidgetService (Dart) for what is written.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/list_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="ZT Tasks"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Open the app to see your tasks"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/add_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_background"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_on_accent"
            android:textSize="22sp"
            android:contentDescription="Add a task"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row_0_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/widget_check_circle"
            android:contentDescription="Complete task"/>
        <LinearLayout
            android:id="@+id/row_0_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/row_0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/row_0_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row_1_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/widget_check_circle"
            android:contentDescription="Complete task"/>
        <LinearLayout
            android:id="@+id/row_1_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/row_1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/row_1_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row_2_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/widget_check_circle"
            android:contentDescription="Complete task"/>
        <LinearLayout
            android:id="@+id/row_2_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/row_2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/row_2_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row_3_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/widget_check_circle"
            android:contentDescription="Complete task"/>
        <LinearLayout
            android:id="@+id/row_3_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/row_3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/row_3_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row_4_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/widget_check_circle"
            android:contentDescription="Complete task"/>
        <LinearLayout
            android:id="@+id/row_4_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/row_4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/row_4_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>
</LinearLayout>
