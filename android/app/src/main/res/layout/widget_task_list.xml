<?xml version="1.0" encoding="utf-8"?>
<!--
  Task list widget, in the shared Zero-Trust widget look
  (Zero-Trust-Core/android-widget-kit). Task titles only appear when "Show
  details on the home screen" is on in Settings; otherwise
  TaskListWidgetProvider fills only the header and the counts line. How many
  rows show depends on the widget's height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/app_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/zt_widget_header_icon"
                    android:layout_height="@dimen/zt_widget_header_icon"
                    android:src="@mipmap/ic_launcher"
                    android:importantForAccessibility="no"/>
                <TextView
                    style="@style/ZtWidget.AppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ZT Tasks"/>
            </LinearLayout>
            <TextView
                android:id="@+id/list_name"
                style="@style/ZtWidget.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="All tasks"/>
            <TextView
                android:id="@+id/summary"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </LinearLayout>
        <ImageView
            android:id="@+id/add_button"
            style="@style/ZtWidget.Action"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_zt_widget_add"
            android:contentDescription="Add a task"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/row_0_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/zt_widget_check_ring"
                android:contentDescription="Complete task"/>
            <LinearLayout
                android:id="@+id/row_0_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">
                <TextView
                    android:id="@+id/row_0_title"
                    style="@style/ZtWidget.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/row_0_due"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/row_1_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/zt_widget_check_ring"
                android:contentDescription="Complete task"/>
            <LinearLayout
                android:id="@+id/row_1_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">
                <TextView
                    android:id="@+id/row_1_title"
                    style="@style/ZtWidget.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/row_1_due"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/row_2_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/zt_widget_check_ring"
                android:contentDescription="Complete task"/>
            <LinearLayout
                android:id="@+id/row_2_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">
                <TextView
                    android:id="@+id/row_2_title"
                    style="@style/ZtWidget.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/row_2_due"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/row_3_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/zt_widget_check_ring"
                android:contentDescription="Complete task"/>
            <LinearLayout
                android:id="@+id/row_3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">
                <TextView
                    android:id="@+id/row_3_title"
                    style="@style/ZtWidget.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/row_3_due"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/row_4_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/zt_widget_check_ring"
                android:contentDescription="Complete task"/>
            <LinearLayout
                android:id="@+id/row_4_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">
                <TextView
                    android:id="@+id/row_4_title"
                    style="@style/ZtWidget.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/row_4_due"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locked"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_zt_widget_lock"
            android:tint="@color/zt_widget_on_surface_variant"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/locked_text"
            style="@style/ZtWidget.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="2"
            android:text="Open ZT Tasks to see your tasks"/>
    </LinearLayout>
</LinearLayout>
