<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 round + that opens quick add (W6). A pure button, so not resizable. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_add_task"
    android:previewLayout="@layout/widget_quick_add_task"
    android:description="@string/quick_add_task_widget_description"
    android:resizeMode="none"
    android:widgetCategory="home_screen">
</appwidget-provider>
